{
    "name": "@skeleton/webpack",
    "version": "1.0.0",
    "description": "skeleton webpack",
    "author": "lambda",
    "license": "ISC",

    "main": "dist/index.js",
    "type": "module",
    "types": "dist/index.d.ts",

    "bin": {
        "skeleton-webpack": "./bin/cli.js"
    },

    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },

    "files": [
        "dist",
        "bin",
        "src"
    ],

    "scripts": {
        "build": "tsc",
        "prepublishOnly": "npm run build"
    },

    "dependencies": {
        "copy-webpack-plugin": "^14.0.0",
        "css-loader": "^7.1.4",
        "html-webpack-plugin": "^5.6.7",
        "mini-css-extract-plugin": "^2.10.2",
        "style-loader": "^4.0.0",
        "ts-loader": "^9.5.7",
        "tsconfig-paths-webpack-plugin": "^4.2.0",
        "webpack": "^5.106.2",
        "webpack-cli": "^7.0.2",
        "webpack-dev-server": "^5.2.3",
        "webpack-merge": "^6.0.1"
    },

    "devDependencies": {
        "@types/node": "*",
        "typescript": "^6.0.3"
    }
}
