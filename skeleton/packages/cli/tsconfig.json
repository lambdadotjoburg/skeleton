{
    "compilerOptions": {

        "target": "ES2022",
        "module": "NodeNext",

        "moduleResolution": "NodeNext",

        "lib": ["ES2022"],
        "types": ["node"],

        "rootDir": "src",
        "outDir": "dist",

        "declaration": true,
        "declarationMap": false,
        "sourceMap": true,

        "strict": true,
        "noImplicitAny": true,
        "noImplicitReturns": true,

        "skipLibCheck": true,
        "noEmitOnError": true,

        "resolveJsonModule": true,
        "forceConsistentCasingInFileNames": true,
        "removeComments": true
    },

    "include": ["src/**/*"],
    "exclude": ["dist", "node_modules"]
}