{
    "name": "@skeleton/cli",
    "version": "1.0.0",
    "author": "lambda",
    "license": "ISC",
    "description": "skeleton cli",

    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",

    "bin": {
        "skeleton": "./bin/cli.js"
    },

    "exports": {
        
