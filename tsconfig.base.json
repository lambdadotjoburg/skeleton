{
    "compilerOptions": {
        
        "target": "ES2022", // emit as-is
        "module": "ESNEXT",

        /**
         * Using a bundler, like webpack or vite!
         * Don't treat module imports like node!
         * Consume ESM packages like @skeleton/core
         * Enable extensionless imports!
         */
        "moduleResolution": "bundler",

        /**
         * Emit declaration files like dist/index.d.ts
         * This is needed for client-code type safety!
         * client-code may import from core like:
         * import { WebApp } from "@skeleton/core";
         * TypeScript needs type info, gotten from
         * node_modules/@skeleton/core
         */
        
        /* included in subpackages */
        // "rootDir": "src",
        // "outDir": "dist",

        "declaration": true,
        "declarationMap": true,
        
        "composite": true,

        "noEmitOnError": true,
        "sourceMap": true,

        /**
         * skip type checking .d.ts files in node_modules
         * Many packages have imperfect/conflicting/legacy types!
         */
        "skipLibCheck": true,

        "strict": true,
        "noImplicitAny": true,
        // "noUnusedLocals": true,
        "noImplicitReturns": true,
        // "noUnusedParameters": true,

        /**
         * enable imports like ./config.json
         */
        "resolveJsonModule": true,
        
        /* @decorator/annotation syntax */
        // "experimentalDecorators": true,
        // "emitDecoratorMetadata": true,

        "forceConsistentCasingInFileNames": true,
        
        "removeComments": true,

        "ignoreDeprecations": "6.0",

        "baseUrl": ".",
    },
    
    "exclude": [
        "dist",
        "node_modules"
    ],
}